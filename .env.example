# ------------------------------------------------------------------
# obsidian-mcp-gateway configuration — read by ./start.sh
# Copy to .env and fill in. NEVER commit the real .env file.
# ------------------------------------------------------------------

# Absolute path to your Obsidian vault folder (the folder that contains .obsidian/)
#   macOS example: /Users/you/Documents/MyVault   ·   Windows example: C:/Users/you/Documents/MyVault
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
# The password you will type in Claude's OAuth login page
MASTER_PASSWORD=choose_a_strong_password
# The secret key the local proxy uses to bypass OAuth for DeepSeek
#   generate one with: openssl rand -hex 32
STATIC_API_KEY=generate_a_random_string
# JWT Secret for OAuth signing
#   generate one with: openssl rand -hex 32
JWT_SECRET=generate_a_random_secret
# (Optional) If using a permanent Cloudflare Named Tunnel, put the name here
CLOUDFLARE_TUNNEL_NAME=
# (Optional) If using a custom domain, put it here (e.g., https://obsidian.mydomain.com)
# Leave empty to get a free, temporary https://<words>.trycloudflare.com URL.
PUBLIC_URL=

# ---------------------------- advanced (optional) ------------------------------
# Access token lifetime in seconds (default 12 hours).
# ACCESS_TOKEN_TTL_SECONDS=43200
# Authorization code lifetime in seconds (default 60, single-use).
# AUTH_CODE_TTL_SECONDS=60
