# ------------------------------------------------------------------
# mcp-oauth-gateway configuration
# Copy to .env and fill in. Never commit the real .env file.
# ------------------------------------------------------------------

# The PUBLIC https:// URL that Claude.ai will use to reach this gateway.
# This must match the external URL of whatever fronts port 3000
# (Cloudflare tunnel, Tailscale Funnel, reverse proxy...), including any
# port like :8443. It becomes the OAuth issuer — if it changes, tokens
# issued before the change stop verifying, and Claude must re-connect.
#
# Examples:
#   PUBLIC_URL=https://obsidian-mcp.example.com
#   PUBLIC_URL=https://anassyed-homelab.tail3bc01f.ts.net:8443
#   PUBLIC_URL=https://reach-respond-constraint-uni.trycloudflare.com
PUBLIC_URL=https://your-public-host.example.com

# Password you (the human) type on the /authorize login page to approve
# Claude's connection. Choose something strong.
MASTER_PASSWORD=change-me-to-a-strong-password

# HS256 secret used to sign/verify JWT access tokens.
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-openssl-rand-base64-48

# The unauthenticated MCP server this gateway protects.
# Inside Docker use http://host.docker.internal:8385 (the compose file maps
# it for Linux hosts; Docker Desktop maps it automatically).
MCP_UPSTREAM_URL=http://127.0.0.1:8385

# --------------------------- optional tuning ----------------------------

# Port the gateway listens on (compose maps host 3000 -> this).
PORT=3000

# Which MCP paths require Bearer auth and are proxied upstream.
# MCP_PROXY_PATHS=/sse,/message,/messages

# Access token lifetime in seconds (default 12h).
# ACCESS_TOKEN_TTL_SECONDS=43200

# Authorization code lifetime in seconds (default 60s, single-use).
# AUTH_CODE_TTL_SECONDS=60
