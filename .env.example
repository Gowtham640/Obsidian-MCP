# ------------------------------------------------------------------
# obsidian-mcp-gateway configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ------------------------------------------------------------------

# The password YOU type on the /authorize login page when Claude
# asks you to sign in. Choose something strong.
MASTER_PASSWORD=choose_a_secure_password

# A long random string used as a static Bearer token by the local
# proxy (DeepSeek / MCP SuperAssistant). Generate one with:
#   openssl rand -hex 32
STATIC_API_KEY=generate_a_random_string_for_deepseek

# HS256 secret used to sign/verify OAuth JWT access tokens.
# Generate one with:
#   openssl rand -base64 48
JWT_SECRET=generate_a_random_secret_for_jwt_signing

# Your Obsidian MCP server's SSE endpoint. If it runs on the same
# machine as Docker, leave the default (host.docker.internal resolves
# to the host inside the container). If it runs elsewhere, point this
# at that host (e.g. http://192.168.1.20:8385/sse).
OBSIDIAN_MCP_URL=http://host.docker.internal:8385/sse

# The PUBLIC https:// URL of the Cloudflare tunnel that fronts port
# 3385 (e.g. https://your-custom-domain.com or a
# https://<words>.trycloudflare.com URL). This becomes the OAuth
# issuer — it must match the URL Claude connects to character-for-
# character, or tokens will not verify.
PUBLIC_URL=https://your-custom-domain.com

# ---------------------------- optional ------------------------------

# Port the gateway listens on (default 3385; compose maps 3385:3385).
# PORT=3385

# Access token lifetime in seconds (default 12 hours).
# ACCESS_TOKEN_TTL_SECONDS=43200

# Authorization code lifetime in seconds (default 60, single-use).
# AUTH_CODE_TTL_SECONDS=60

# MCP paths that require auth and get proxied upstream.
# PROXY_PATHS=/sse,/message,/messages
